     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "delta", "}"}], ",", 
       RowBox[{
        RowBox[{"delta", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"4", "*", "S", "*", "S"}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Simplified", " ", "for", " ", "S"}], "=", 
          RowBox[{"alpha", " ", "case", " ", "or", " ", "similar"}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Let", "'"}], "s", " ", "use", " ", "the", " ", "standard", 
