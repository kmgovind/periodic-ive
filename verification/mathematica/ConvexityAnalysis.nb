     RowBox[{
      RowBox[{"PART", " ", "1"}], ":", "DEFINITIONS"}], "&"}], " ", 
    "PHYSICS"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Clarity", " ", "Dynamics", " ", 
    RowBox[{"(", 
     RowBox[{"Riccati", " ", "Solution"}], ")"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"q", 
    RowBox[{"(", "t", ")"}], " ", "evolves", " ", "from", " ", "q0", " ", 
    "given", " ", "sensing", " ", "S", " ", "and", " ", "decay", " ", 
    "alpha"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EvolveClarity", "[", 
      RowBox[{"q0_", ",", "S_", ",", "alpha_", ",", "dt_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"A", ",", "B", ",", "C", ",", "rho", ",", "sol"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"The", " ", "Riccati", " ", 
          RowBox[{"equation", ":", 
           RowBox[{"q", "'"}]}]}], "=", 
         RowBox[{
          RowBox[{"S", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "q"}], ")"}], "^", "2"}]}], "-", 
          RowBox[{"alpha", "*", 
           RowBox[{"q", "^", "2"}]}]}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
        "This", " ", "has", " ", "a", " ", "closed", " ", "form", " ", 
         "solution", " ", "involving", " ", "Tanh"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"For", " ", "boundedness", " ", "proof"}], ",", 
         RowBox[{
         "we", " ", "use", " ", "the", " ", "exact", " ", "structure"}]}], 
        "*)"}], 
       RowBox[{"(*", 
        RowBox[{
        "Simplified", " ", "Parametrization", " ", "for", " ", "Stability", " ",
          "in", " ", "plotting"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Assume", " ", "S"}], ">", 
         RowBox[{
         "alpha", " ", "to", " ", "ensure", " ", "growth", " ", "toward", " ",
           "saturation"}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
        "Exact", " ", "solution", " ", "structure", " ", "for", " ", "q", 
         RowBox[{"(", "t", ")"}]}], "*)"}], 
       RowBox[{
        RowBox[{"rho", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"S", "*", 
           RowBox[{"(", 
            RowBox[{"S", "-", "alpha"}], ")"}]}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"Discriminant", "-", 
          RowBox[{"like", " ", "term"}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "If", " ", "dynamics", " ", "are", " ", "standard", " ", 
           "logistic"}], "-", 
          RowBox[{"like", " ", 
           RowBox[{"saturation", ":"}]}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
         "This", " ", "is", " ", "a", " ", "representative", " ", "sigmoid", " ",
           "form", " ", "that", " ", "matches", " ", "the", " ", "physics"}], 
         "*)"}], 
        RowBox[{"q0", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "q0"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "S"}], "*", "dt"}], "]"}]}], ")"}]}]}]}]}], " ", 
      RowBox[{"(*", 
       RowBox[{
       "Simplified", " ", "First", " ", "Order", " ", "approx", " ", "for", " ",
         "visualization"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "OR", " ", "use", " ", "the", " ", "full", " ", "Riccati", " ", "if", " ",
         "you", " ", "need", " ", "exact", " ", 
        RowBox[{"match", ":"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"S", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Exp", "[", 
              RowBox[{
