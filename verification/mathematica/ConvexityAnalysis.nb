   RowBox[{
    RowBox[{"dsVal", "=", "100.0"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"100", " ", "meters"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"khVal", "=", "10.0"}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"Hotel", " ", "load"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"kmVal", "=", "0.5"}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"Drag", " ", "coeff"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"alphaVal", "=", "0.01"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"qStart", "=", "0.1"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "random", " ", "sensing", " ", "field", " ", "and", " ", 
     "weights"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Svals", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.0", ",", "0.05"}], "}"}], ",", "NumSegments"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Gvals", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.0", ",", "1.0"}], "}"}], ",", "NumSegments"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "symbolic", " ", "vector", " ", "of", " ", "dwell", " ", 
     "times"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dtVars", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Symbol", "[", 
        RowBox[{"\"\<t\>\"", "<>", 
         RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "NumSegments"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Build", " ", "the", " ", "chain", " ", "of", " ", "states"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qCurrent", "=", "qStart"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"qList", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", "NumSegments"}], ",", 
      RowBox[{"i", "++"}], ",", 
      RowBox[{
       RowBox[{"qNext", "=", 
        RowBox[{"EvolveClarity", "[", 
         RowBox[{"qCurrent", ",", 
          RowBox[{"Svals", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "alphaVal", ",", 
          RowBox[{"dtVars", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"qList", ",", "qNext"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"qCurrent", "=", "qNext"}], ";"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Build", " ", "Numeric", " ", "Objective"}], "&"}], " ", 
     "Energy"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JNum", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Gvals", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "*", 
        RowBox[{"qList", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "NumSegments"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ENum", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"SegmentEnergy", "[", 
        RowBox[{
         RowBox[{"dtVars", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "dsVal", ",", "khVal", ",", 
         "kmVal"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "NumSegments"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Pick", " ", "a", " ", "nominal", " ", "operating", " ", "point", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"e", ".", "g", "."}], ",", 
       RowBox[{"u", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"m", "/", "s"}]}], "->", "dt"}], "=", 
         RowBox[{"50", "s"}]}]}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"opPoint", "=", 
     RowBox[{"Thread", "[", 
      RowBox[{"dtVars", "->", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"50.0", ",", "NumSegments"}], "]"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Evaluate", " ", "Numerical", " ", "Matrices", " ", "at", " ", "this", " ",
      "point"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NumHessJ", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"JNum", ",", 
         RowBox[{"{", 
          RowBox[{"dtVars", ",", "2"}], "}"}]}], "]"}], "/.", " ", 
       "opPoint"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"NumHessE", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"ENum", ",", 
         RowBox[{"{", 
          RowBox[{"dtVars", ",", "2"}], "}"}]}], "]"}], "/.", " ", 
       "opPoint"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"FUNCTION", ":", 
     RowBox[{
     "Max", " ", "Eigenvalue", " ", "of", " ", "Lagrangian", " ", "Hessian", " ",
       "for", " ", "a", " ", "given", " ", "Lambda"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"If", " ", "MaxEig"}], "<", "0"}], ",", 
     RowBox[{
     "the", " ", "matrix", " ", "is", " ", "Negative", " ", "Definite", " ", 
      RowBox[{"(", 
       RowBox[{"Strictly", " ", "Concave"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MaxEigenvalueL", "[", "lam_", "]"}], ":=", 
     RowBox[{"Max", "[", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{"NumHessJ", "-", 
        RowBox[{"lam", "*", "NumHessE"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<--- Eigenvalue Analysis ---\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Energy Hessian Eigenvalues (Should be all +): \>\"", ",", 
      RowBox[{"Eigenvalues", "[", "NumHessE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Objective Hessian Eigenvalues (Mixed +/-): \>\"", ",", 
      RowBox[{"Eigenvalues", "[", "NumHessJ", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "the", " ", "\"\<Concavity\>\"", " ", "vs", " ", "Lambda"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "threshold", " ", "where", " ", "the", " ", "curve", " ", 
     "crosses", " ", "0", " ", "is", " ", "the", " ", "minimum", " ", 
     "Lambda", " ", "needed", " ", "for", " ", "uniqueness"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"MaxEigenvalueL", "[", "lam", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"lam", ",", "0", ",", "100"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Lambda (Energy Price)\>\"", 
        ",", "\"\<Max Eigenvalue of Hessian L\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Condition for Unique Global Opt: Max Eig < 0\>\""}], ",", 
     RowBox[{"GridLines", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "0", "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Red"}], "}"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.979631694503605*^9, 3.979631694503605*^9}, 
   3.9796317649126053`*^9},
 CellLabel->"In[53]:=",ExpressionUUID->"5ea9ee15-3358-bd43-abcc-e520357dd1c2"],

