   "3.", " ", "Compute", " ", "the", " ", "First", " ", "and", " ", "Second", 
    " ", "Derivatives", " ", "with", " ", "respect", " ", "to", " ", "dwell", 
    " ", "time", " ", "dt"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sens1", "=", 
     RowBox[{"D", "[", 
      RowBox[{"scaledDyn", ",", "dt"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Marginal", " ", "change"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sens2", "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"sens1", ",", "dt"}], "]"}], "//", "Expand"}]}], ";"}], " ", 
   RowBox[{"(*", "Curvature", "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9792128736627483`*^9, 3.9792128809472294`*^9}},
 CellLabel->
  "In[357]:=",ExpressionUUID->"178bce1d-214f-b34b-8968-3e0cef0cd011"],

