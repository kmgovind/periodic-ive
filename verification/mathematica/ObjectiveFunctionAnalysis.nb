Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"2.", " ", "Sensitivity", " ", "Analysis"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Let", " ", 
    RowBox[{"q", "[", "t", "]"}], " ", "be", " ", "the", " ", 
    RowBox[{"solution", ".", "We"}], " ", "look", " ", "at", " ", "how", " ", 
    "q", " ", "changes", " ", "as", " ", "we", " ", "scale", " ", 
    RowBox[{"time", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Define", " ", "a", " ", "scaled", " ", "time", " ", "version", " ", 
     "where", " ", "tau"}], "=", 
    RowBox[{"t", "/", "dt"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"dq", "/", "dtau"}], "=", 
    RowBox[{"dt", "*", "f", 
     RowBox[{"(", 
      RowBox[{"q", ",", "s"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"scaledDyn", "=", 
    RowBox[{"dt", "*", 
     RowBox[{"f", "[", 
      RowBox[{
       RowBox[{"q", "[", "tau", "]"}], ",", "s"}], "]"}]}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9792128736627483`*^9, 3.979212879738062*^9}, 
   3.9792254496566296`*^9},
 CellLabel->
  "In[356]:=",ExpressionUUID->"469dce8a-392f-314f-90b1-11c12dda559d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
