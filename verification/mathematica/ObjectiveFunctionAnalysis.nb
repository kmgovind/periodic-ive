Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "Clarity", " ", "Dynamics", " ", 
    "Function"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"q_", ",", "s_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"s", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "q"}], ")"}], "^", "2"}]}], "-", 
    RowBox[{"alpha", "*", 
     RowBox[{"q", "^", "2"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9792128736627483`*^9, 3.979212877315445*^9}, 
