Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "energy", " ", "consumed", " ", "in", " ", 
    "segment", " ", "i", " ", "as", " ", "a", " ", "function", " ", "of", " ",
     "dwell", " ", "time", " ", "dt"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Energy", "[", "dt_", "]"}], ":=", 
   RowBox[{
    RowBox[{"kh", "*", "dt"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"km", "*", 
       RowBox[{"ds", "^", "3"}]}], ")"}], "/", 
     RowBox[{"dt", "^", "2"}]}]}]}]}]], "Input",
