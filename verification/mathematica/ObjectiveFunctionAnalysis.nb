Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "averaged", " ", "clarity", " ", "dynamics", " ",
     "ODE", " ", "at", " ", "equilibrium"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"avgDynamics", "=", 
     RowBox[{
      RowBox[{"sAvg", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "q"}], ")"}], "^", "2"}]}], "-", 
      RowBox[{"alpha", "*", 
       RowBox[{"q", "^", "2"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solve", " ", "for", " ", "q"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"avgDynamics", "==", "0"}], ",", "q"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Simplify", " ", "the", " ", "positive", " ", "root"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"q", "/.", " ", 
      RowBox[{"sol", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sAvg", ">", "0"}], ",", 
