Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "marginal", " ", "energy", " ", "cost", " ", 
    RowBox[{"(", 
     RowBox[{
     "RHS", " ", "of", " ", "your", " ", "stationarity", " ", "condition"}], 
     ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"marginalEnergyCost", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Energy", "[", "dt", "]"}], ",", "dt"}], "]"}], "//", 
